# RunningHub SDK examples

# Required for both example scripts
RUNNINGHUB_API_KEY=your-api-key

# Optional for examples/smoke_validate_sdk.py
RUNNINGHUB_AI_APP_ID=1937084629516193794

# Required for examples/run_workflow_task.py
RUNNINGHUB_WORKFLOW_ID=your-workflow-id

# Optional for NodeModifier validation in examples/run_workflow_task.py
RUNNINGHUB_PROMPT_NODE_ID=6
RUNNINGHUB_PROMPT_TEXT=a cinematic portrait, ultra detailed
RUNNINGHUB_NEGATIVE_PROMPT_NODE_ID=7
RUNNINGHUB_NEGATIVE_PROMPT_TEXT=blurry, low quality
RUNNINGHUB_SAMPLER_NODE_ID=3
RUNNINGHUB_SEED=12345
RUNNINGHUB_STEPS=28
RUNNINGHUB_CFG=7.0
RUNNINGHUB_SIZE_NODE_ID=5
RUNNINGHUB_WIDTH=1024
RUNNINGHUB_HEIGHT=1024

# Optional polling controls for examples/run_workflow_task.py
RUNNINGHUB_POLL_INTERVAL=3
RUNNINGHUB_TIMEOUT=600

# Optional for examples/run_workflow_v2_qwen_camera.py
RUNNINGHUB_QWEN_CAMERA_WORKFLOW_ID=2051509626218270722
RUNNINGHUB_QWEN_CAMERA_POLL_INTERVAL=5
RUNNINGHUB_QWEN_CAMERA_TIMEOUT=1800
RUNNINGHUB_QWEN_CAMERA_POSITIVE_NODE_ID=147
RUNNINGHUB_QWEN_CAMERA_POSITIVE_PROMPT=
RUNNINGHUB_QWEN_CAMERA_NEGATIVE_NODE_ID=143
RUNNINGHUB_QWEN_CAMERA_NEGATIVE_PROMPT=
RUNNINGHUB_QWEN_CAMERA_SAMPLER_NODE_ID=137
RUNNINGHUB_QWEN_CAMERA_SEED=
RUNNINGHUB_QWEN_CAMERA_STEPS=
RUNNINGHUB_QWEN_CAMERA_CFG=
RUNNINGHUB_QWEN_CAMERA_SAMPLER_NAME=
RUNNINGHUB_QWEN_CAMERA_SCHEDULER=
RUNNINGHUB_QWEN_CAMERA_IMAGE_NODE_ID=106
RUNNINGHUB_QWEN_CAMERA_IMAGE_PATH=

# Optional for examples/run_workflow_doubao_seedance_video.py
RUNNINGHUB_DOUBAO_VIDEO_WORKFLOW_ID=2004066004755988481
RUNNINGHUB_DOUBAO_VIDEO_POLL_INTERVAL=5
RUNNINGHUB_DOUBAO_VIDEO_TIMEOUT=1800

# Optional for examples/run_doubao_video_from_deepseek_prompt.py
# Note:
# - RUNNINGHUB_API_KEY is the RunningHub OpenAPI key, used by SDK workflow calls.
# - DEEPSEEK_API_KEY is the DeepSeek LLM key, used only for prompt generation.
# - These two keys come from different services and must not be mixed.
DEEPSEEK_API_KEY=
RUNNINGHUB_DEEPSEEK_PROMPT_OUTPUT=outputs/deepseek_doubao_video_prompt.json
RUNNINGHUB_DEEPSEEK_MODEL=deepseek-chat
RUNNINGHUB_DEEPSEEK_IDEA=A glamorous Shanghai songstress in a 1930s parlor, camera slowly pushing in as she turns toward a warm gramophone glow.
RUNNINGHUB_DEEPSEEK_STYLE=cinematic, elegant, vintage Chinese interior, realistic, smooth camera movement, moody lighting
RUNNINGHUB_DEEPSEEK_DURATION=8 seconds
RUNNINGHUB_DOUBAO_VIDEO_PROMPT_NODE_ID=1